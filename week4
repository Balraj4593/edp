<!DOCTYPE html>
<html lang="en"
      xmlns:th="http://www.thymeleaf.org">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Job Form - Placement Portal</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        th:href="@{/css/style.css}">

</head>


<body>

<nav class="navbar navbar-dark bg-primary">

    <div class="container">

        <a class="navbar-brand fw-bold"
           th:href="@{/dashboard}">

            Placement Management Portal

        </a>

    </div>

</nav>


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <h2 class="mb-4"
                        th:text="${job.id == null ?
                        'Add Job' :
                        'Edit Job'}">

                        Job Form

                    </h2>


                    <form
                        th:action="@{/jobs/save}"
                        th:object="${job}"
                        method="post">


                        <input
                            type="hidden"
                            th:field="*{id}">


                        <div class="row g-3">


                            <!-- Job Title -->

                            <div class="col-md-6">

                                <label class="form-label">

                                    Job Title *

                                </label>

                                <input
                                    class="form-control"
                                    th:field="*{title}"
                                    placeholder="Java Developer">

                                <div
                                    class="text-danger small"
                                    th:errors="*{title}">
                                </div>

                            </div>


                            <!-- Company -->

                            <div class="col-md-6">

                                <label class="form-label">

                                    Company *

                                </label>

                                <select
                                    class="form-select"
                                    th:field="*{company}">

                                    <option value="">
                                        Select Company
                                    </option>

                                    <option
                                        th:each="company : ${companies}"
                                        th:value="${company.id}"
                                        th:text="${company.name}">

                                    </option>

                                </select>

                            </div>


                            <!-- Location -->

                            <div class="col-md-6">

                                <label class="form-label">

                                    Location *

                                </label>

                                <input
                                    class="form-control"
                                    th:field="*{location}"
                                    placeholder="Hyderabad">

                                <div
                                    class="text-danger small"
                                    th:errors="*{location}">
                                </div>

                            </div>


                            <!-- Package -->

                            <div class="col-md-6">

                                <label class="form-label">

                                    Package (LPA) *

                                </label>

                                <input
                                    type="number"
                                    step="0.01"
                                    class="form-control"
                                    th:field="*{packageLpa}"
                                    placeholder="6.50">

                                <div
                                    class="text-danger small"
                                    th:errors="*{packageLpa}">
                                </div>

                            </div>


                            <!-- Description -->

                            <div class="col-12">

                                <label class="form-label">

                                    Job Description *

                                </label>

                                <textarea
                                    class="form-control"
                                    rows="5"
                                    th:field="*{description}"
                                    placeholder="Enter job requirements and responsibilities">
                                </textarea>

                                <div
                                    class="text-danger small"
                                    th:errors="*{description}">
                                </div>

                            </div>


                        </div>


                        <div class="mt-4">

                            <button
                                class="btn btn-primary"
                                type="submit">

                                Save Job

                            </button>


                            <a
                                class="btn btn-secondary"
                                th:href="@{/jobs}">

                                Cancel

                            </a>

                        </div>


                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

</body>

</html>
