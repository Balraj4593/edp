package com.placement.portal;

import com.placement.portal.entity.Student;
import com.placement.portal.repository.StudentRepository;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;

import java.math.BigDecimal;
import static org.assertj.core.api.Assertions.assertThat;

@DataJpaTest
class StudentRepositoryTests {

    @Autowired
    private StudentRepository studentRepository;

    @Test
    void savesAndFindsStudent() {
        Student student = new Student();
        student.setName("Demo Student");
        student.setEmail("demo.student@example.com");
        student.setPhone("9876543210");
        student.setDepartment("CSE");
        student.setGraduationYear(2028);
        student.setCgpa(new BigDecimal("7.90"));

        Student saved = studentRepository.save(student);

        assertThat(saved.getId()).isNotNull();
        assertThat(studentRepository.findById(saved.getId()))
                .isPresent();
    }
}

package com.placement.portal;

import com.placement.portal.entity.Company;
import com.placement.portal.entity.Job;
import com.placement.portal.repository.CompanyRepository;
import com.placement.portal.repository.JobRepository;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;

import java.math.BigDecimal;
import static org.assertj.core.api.Assertions.assertThat;

@DataJpaTest
class JobRepositoryTests {

    @Autowired
    private CompanyRepository companyRepository;

    @Autowired
    private JobRepository jobRepository;

    @Test
    void savesJobLinkedToCompany() {
        Company company = new Company();
        company.setName("Test Company");
        company.setLocation("Hyderabad");
        company = companyRepository.save(company);

        Job job = new Job();
        job.setTitle("Java Developer");
        job.setDescription("Entry-level Java role");
        job.setLocation("Hyderabad");
        job.setPackageLpa(new BigDecimal("6.50"));
        job.setCompany(company);

        Job saved = jobRepository.save(job);

        assertThat(saved.getId()).isNotNull();
        assertThat(saved.getCompany().getId())
                .isEqualTo(company.getId());
        assertThat(jobRepository.findById(saved.getId()))
                .isPresent();
    }
}
